# Configuração opcional da API (python src/api.py). Copie para .env se quiser documentar valores locais;
# a API lê estas variáveis do ambiente do processo.
API_HOST=127.0.0.1
API_PORT=8000
# Origens autorizadas a chamar a API pelo navegador (separadas por vírgula).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
